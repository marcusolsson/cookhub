package views

templ AllRecipesPage(cookbook Cookbook) {
	@page(cookbook.Title, cookbook.BaseURL) {
		<h1>{ cookbook.Title }</h1>
		if len(cookbook.Recipes) == 0 {
			<p class="description">
				No recipes found.
			</p>
		} else {
			<p class="description">
				Browse all { len(cookbook.Recipes) } recipes in this cookbook.
			</p>
			<section class="recipe-list">
				for _, file := range cookbook.Recipes {
					<article class="recipe-card">
						<h2><a href={ templ.URL(file.URL) }>{ file.Stem }</a></h2>
					</article>
				}
			</section>
		}
	}
}
