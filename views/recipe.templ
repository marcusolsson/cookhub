package views

import (
	"strings"
	"fmt"

	"github.com/aquilax/cooklang-go"
)

templ columns() {
	<div class="columns">
		{ children... }
	</div>
}

templ RecipeView(meta *RecipeMetadata, author Author, recipe *cooklang.RecipeV2, raw string, canonicalURL string) {
	<!DOCTYPE html>
	<html>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>CookHub</title>
			<link rel="stylesheet" href="/static/styles.css"/>
			<link rel="canonical" href={ templ.URL(canonicalURL) }/>
		</head>
		<body>
			<main class="container">
				@recipeHeader(meta, author, canonicalURL)
				@canonicalMetadata(meta)
				@columns() {
					@recipeInstructions(recipe, author, meta)
					@recipeIngredients(recipe, author, meta)
				}
				<details>
					<summary>View the raw recipe</summary>
					<pre>
						<code>{ raw }</code>
					</pre>
				</details>
			</main>
			<script src="https://unpkg.com/lucide@latest"></script>
			<script>
                lucide.createIcons({ 
                    attrs: { 
                        class: ['icon'], 
                        'stroke-width': 2 
                    } 
                });
            </script>
		</body>
	</html>
}

templ recipeHeader(meta *RecipeMetadata, a Author, canonicalURL string) {
	<header class="recipe-header">
		<h1>{ meta.Title() }</h1>
		<div class="recipe-meta">
			@author(a)
			<div class="btn-group">
				<a class="btn-icon" href={ templ.URL(canonicalURL) }><i data-lucide="github"></i></a>
				if source := meta.Source(); source != nil {
					<a class="btn-icon" href={ templ.URL(source.String()) }><i data-lucide="external-link"></i></a>
				}
			</div>
		</div>
		if len(meta.Tags()) > 0 {
			<div>
				for _, t := range meta.Tags() {
					@Tag(t)
				}
			</div>
		}
		if desc := meta.Description(); desc != "" {
			<p>{ desc }</p>
		}
		if u := meta.ImageURL(); u != "" {
			@Image(u)
		}
	</header>
}

templ author(a Author) {
	<div class="author">
		@Avatar(a.Owner.AvatarURL)
		@Link(a.Owner.Login, a.Owner.URL)
	</div>
}

templ canonicalMetadata(meta *RecipeMetadata) {
	<table id="metadata-table">
		<tbody>
			if cuisine := meta.Cuisine(); cuisine != "" {
				<tr><td>Cuisine</td><td>{ cuisine }</td></tr>
			}
			if course := meta.Course(); course != "" {
				<tr><td>Course</td><td>{ course }</td></tr>
			}
			if category := meta.Category(); category != "" {
				<tr><td>Category</td><td>{ category }</td></tr>
			}
			if t := meta.TotalTime(); t != "" {
				<tr><td>Total time</td><td>{ t }</td></tr>
			}
			if t := meta.PrepTime(); t != "" {
				<tr><td>Prep time</td><td>{ t }</td></tr>
			}
			if t := meta.CookTime(); t != "" {
				<tr><td>Cook time</td><td>{ t }</td></tr>
			}
		</tbody>
	</table>
}

templ recipeIngredients(recipe *cooklang.RecipeV2, author Author, meta *RecipeMetadata) {
	<aside id="ingredients">
		<h2>
			Ingredients
			if servings := meta.Servings(); servings > 0 {
				<div id="servings">
					<i data-lucide="utensils" style="max-width: 1em; max-height: 1em;"></i>{ servings }
				</div>
			}
		</h2>
		<ul>
			for _, section := range recipe.Steps {
				for _, step := range section {
					switch val := step.(type) {
						case cooklang.IngredientV2:
							<li>
								switch  {
									case val.Units == "" && val.Quantity == 0:
										@ingredient(val.Name, author, meta)
									case val.Units == "":
										{ fmt.Sprintf("%v ", val.Quantity) }
										@ingredient(val.Name, author, meta)
									default:
										{ fmt.Sprintf("%v %s ", val.Quantity, val.Units) }
										@ingredient(val.Name, author, meta)
								}
							</li>
					}
				}
			}
		</ul>
	</aside>
}

templ ingredient(name string, author Author, meta *RecipeMetadata) {
	if strings.HasPrefix(name, "./") {
		<a href={ templ.URL(resolveRecipe("/github.com/"+author.FullName+meta.File.Name, name+".cook")) }>
			{ strings.TrimPrefix(name, "./") }
		</a>
	} else {
		{ name }
	}
}

templ recipeInstructions(recipe *cooklang.RecipeV2, author Author, meta *RecipeMetadata) {
	<section id="instructions">
		<h2>Instructions</h2>
		for _, step := range recipe.Steps {
			for _, component := range step {
				@recipeStep(component, author, meta)
			}
		}
	</section>
}

templ recipeStep(step any, author Author, meta *RecipeMetadata) {
	switch val := step.(type) {
		case cooklang.TextV2:
			<span>{ val.Value }</span>
			if strings.HasSuffix(val.Value, ".") {
				<br/>
				<br/>
			}
		case cooklang.IngredientV2:
			if strings.HasPrefix(val.Name, "./") {
				<a href={ templ.URL(resolveRecipe("/github.com/"+author.FullName+meta.File.Name, val.Name+".cook")) }>{ strings.TrimPrefix(val.Name, "./") }</a>
			} else {
				<dfn title={ ingredientAsString(val) }>{ val.Name }</dfn>
			}
		case cooklang.CookwareV2:
			<span>{ val.Name }</span>
		case cooklang.TimerV2:
			<time datetime={ DurationToISO8601(timerAsDuration(val)) }>
				{ fmt.Sprintf("%v %s", val.Quantity, val.Unit) }
			</time>
	}
}
