package views

import (
	"strings"

	"github.com/aquilax/cooklang-go"
	"github.com/marcusolsson/cookhub/utils"
)

templ cooklangStep(step any, fileRef utils.RepoFileRef) {
	switch val := step.(type) {
		case cooklang.TextV2:
			@cooklangText(val)
		case cooklang.IngredientV2:
			@cooklangIngredient(val, fileRef)
		case cooklang.CookwareV2:
			@cooklangCookware(val)
		case cooklang.TimerV2:
			@cooklangTimer(val)
	}
}

templ cooklangText(val cooklang.TextV2) {
	<span>{ val.Value }</span>
	if strings.HasSuffix(val.Value, ".") {
		<br/>
		<br/>
	}
}

templ cooklangIngredient(val cooklang.IngredientV2, fileRef utils.RepoFileRef) {
	if strings.HasPrefix(val.Name, "./") {
		{{ u := utils.ResolveRecipe("/"+fileRef.ID(), val.Name+".cook") }}
		<a href={ templ.URL(u) }>
			{ strings.TrimPrefix(val.Name, "./") }
		</a>
	} else {
		<dfn title={ utils.IngredientAsString(val) }>
			{ val.Name }
		</dfn>
	}
}

templ cooklangIngredientText(name string, fileRef utils.RepoFileRef) {
	if strings.HasPrefix(name, "./") {
		{{ u := utils.ResolveRecipe("/"+fileRef.ID(), name+".cook") }}
		<a href={ templ.URL(u) }>
			{ strings.TrimPrefix(name, "./") }
		</a>
	} else {
		{ name }
	}
}

templ cooklangCookware(cookware cooklang.CookwareV2) {
	<span>{ cookware.Name }</span>
}

templ cooklangTimer(timer cooklang.TimerV2) {
	{{ d := utils.TimerAsDuration(timer) }}
	<time datetime={ utils.DurationToISO8601(d) }>
		{ timer.Quantity } { timer.Unit }
	</time>
}
