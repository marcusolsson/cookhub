package views

import (
	"strings"
	"fmt"

	"github.com/aquilax/cooklang-go"
	"github.com/marcusolsson/cookhub/utils"
	"github.com/marcusolsson/cookhub/github"
)

templ columns() {
	<div class="columns">
		{ children... }
	</div>
}

templ RecipeView(meta *utils.RecipeMetadata, author github.Repository, recipe *cooklang.RecipeV2, raw string, fileRef utils.RepoFileRef) {
	<!DOCTYPE html>
	<html>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>CookHub</title>
			<link rel="stylesheet" href="/static/styles.css"/>
			<link rel="canonical" href={ templ.URL(fileRef.URL().String()) }/>
		</head>
		<body>
			<main class="container">
				@recipeHeader(meta, author, fileRef)
				@canonicalMetadata(meta)
				@columns() {
					@recipeInstructions(recipe, fileRef)
					@recipeIngredients(recipe, author, meta, fileRef)
				}
				<details>
					<summary>View the raw recipe</summary>
					<pre>
						<code>{ raw }</code>
					</pre>
				</details>
			</main>
			<script src="https://unpkg.com/lucide@latest"></script>
			<script>
                lucide.createIcons({ 
                    attrs: { 
                        class: ['icon'], 
                        'stroke-width': 2 
                    } 
                });
            </script>
		</body>
	</html>
}

templ recipeHeader(meta *utils.RecipeMetadata, a github.Repository, fileRef utils.RepoFileRef) {
	<header class="recipe-header">
		<h1>{ meta.Title() }</h1>
		<div class="recipe-meta">
			@author(a.Owner.Login, a.Owner.URL, a.Owner.AvatarURL)
			<div class="btn-group">
				<a class="btn-icon" href={ templ.URL(fileRef.URL().String()) }>
					@Icon("github")
				</a>
				if source := meta.Source(); source != nil {
					<a class="btn-icon" href={ templ.URL(source.String()) }>
						@Icon("external-link")
					</a>
				}
			</div>
		</div>
		if len(meta.Tags()) > 0 {
			<div>
				for _, t := range meta.Tags() {
					@Tag(t)
				}
			</div>
		}
		if desc := meta.Description(); desc != "" {
			<p>{ desc }</p>
		}
		if u := meta.ImageURL(); u != "" {
			@Image(u)
		}
	</header>
}

templ author(authorName, authorURL, avatarURL string) {
	<div class="author">
		@Avatar(avatarURL)
		@Link(authorName, authorURL)
	</div>
}

templ canonicalMetadata(meta *utils.RecipeMetadata) {
	<table id="metadata-table">
		<tbody>
			if cuisine := meta.Cuisine(); cuisine != "" {
				<tr><td>Cuisine</td><td>{ cuisine }</td></tr>
			}
			if course := meta.Course(); course != "" {
				<tr><td>Course</td><td>{ course }</td></tr>
			}
			if category := meta.Category(); category != "" {
				<tr><td>Category</td><td>{ category }</td></tr>
			}
			if t := meta.TotalTime(); t != "" {
				<tr><td>Total time</td><td>{ t }</td></tr>
			}
			if t := meta.PrepTime(); t != "" {
				<tr><td>Prep time</td><td>{ t }</td></tr>
			}
			if t := meta.CookTime(); t != "" {
				<tr><td>Cook time</td><td>{ t }</td></tr>
			}
		</tbody>
	</table>
}

templ recipeIngredients(recipe *cooklang.RecipeV2, author github.Repository, meta *utils.RecipeMetadata, fileRef utils.RepoFileRef) {
	<aside id="ingredients">
		<h2>
			Ingredients
			if servings := meta.Servings(); servings > 0 {
				@servingsLabel(servings)
			}
		</h2>
		@cooklangIngredientList(recipe.Steps, fileRef)
	</aside>
}

templ servingsLabel(servings float64) {
	<div id="servings">
		<i data-lucide="utensils" style="max-width: 1em; max-height: 1em;"></i>{ servings }
	</div>
}

templ cooklangIngredientList(steps []cooklang.StepV2, fileRef utils.RepoFileRef) {
	<ul>
		for _, section := range steps {
			for _, step := range section {
				switch val := step.(type) {
					case cooklang.IngredientV2:
						@cooklangIngredientListItem(val, fileRef)
				}
			}
		}
	</ul>
}

templ cooklangIngredientListItem(val cooklang.IngredientV2, fileRef utils.RepoFileRef) {
	<li>
		switch  {
			case val.Units == "" && val.Quantity == 0:
				@cooklangIngredientText(val.Name, fileRef)
			case val.Units == "":
				{ fmt.Sprintf("%v ", val.Quantity) }
				@cooklangIngredientText(val.Name, fileRef)
			default:
				{ fmt.Sprintf("%v %s ", val.Quantity, val.Units) }
				@cooklangIngredientText(val.Name, fileRef)
		}
	</li>
}

templ recipeInstructions(recipe *cooklang.RecipeV2, fileRef utils.RepoFileRef) {
	<section id="instructions">
		<h2>Instructions</h2>
		for _, step := range recipe.Steps {
			for _, component := range step {
				@cooklangStep(component, fileRef)
			}
		}
	</section>
}

templ cooklangStep(step any, fileRef utils.RepoFileRef) {
	switch val := step.(type) {
		case cooklang.TextV2:
			@cooklangText(val)
		case cooklang.IngredientV2:
			@cooklangIngredient(val, fileRef)
		case cooklang.CookwareV2:
			@cooklangCookware(val)
		case cooklang.TimerV2:
			@cooklangTimer(val)
	}
}

templ cooklangText(val cooklang.TextV2) {
	<span>{ val.Value }</span>
	if strings.HasSuffix(val.Value, ".") {
		<br/>
		<br/>
	}
}

templ cooklangIngredient(val cooklang.IngredientV2, fileRef utils.RepoFileRef) {
	if strings.HasPrefix(val.Name, "./") {
		<a href={ templ.URL(utils.ResolveRecipe("/"+fileRef.ID(), val.Name+".cook")) }>{ strings.TrimPrefix(val.Name, "./") }</a>
	} else {
		<dfn title={ utils.IngredientAsString(val) }>{ val.Name }</dfn>
	}
}

templ cooklangIngredientText(name string, fileRef utils.RepoFileRef) {
	if strings.HasPrefix(name, "./") {
		<a href={ templ.URL(utils.ResolveRecipe("/"+fileRef.ID(), name+".cook")) }>{ strings.TrimPrefix(name, "./") } </a>
	} else {
		{ name }
	}
}

templ cooklangCookware(cookware cooklang.CookwareV2) {
	<span>{ cookware.Name }</span>
}

templ cooklangTimer(timer cooklang.TimerV2) {
	{{ d := utils.TimerAsDuration(timer) }}
	<time datetime={ utils.DurationToISO8601(d) }>
		{ children... }
	</time>
}
