package views

import (
	"fmt"
	"path/filepath"
	"strings"

	"github.com/aquilax/cooklang-go"
)

type RecipeViewModel struct {
	Recipe  *cooklang.RecipeV2
	File    RecipeFile
	BaseURL string
}

func resolveRecipeURL(file RecipeFile, relPath string) string {
	// Remove .cook extension from relPath if present, add .html
	relPath = strings.TrimSuffix(relPath, ".cook") + ".html"
	// Resolve relative to current file's directory
	dir := filepath.Dir(file.URL)
	return filepath.Join(dir, relPath)
}

templ RecipePage(pd *RecipeViewModel) {
	{{ meta := ParseCanonicalMetadata(pd.Recipe) }}
	@page(meta.Title(pd.File.Path) + " - CookHub", pd.BaseURL) {
		@recipePageHeader(meta, pd.File, pd.BaseURL)
		@Columns() {
			<div style="display: flex; flex-direction: column; gap: 2rem;">
				@recipeIngredients(pd.Recipe, meta.Servings(), pd.File)
				@recipeCookware(pd.Recipe, pd.File)
			</div>
			@recipeInstructions(pd.Recipe, pd.File)
		}
		<details>
			<summary>View the raw recipe</summary>
			<pre>
				<code>{ pd.File.Content }</code>
			</pre>
		</details>
	}
}

templ recipePageHeader(meta *RecipeMetadata, file RecipeFile, baseURL string) {
	<header class="recipe-header">
		if u := meta.ImageURL(); u != "" {
			@Image(u)
		}
		<h1>{ meta.Title(file.Path) }</h1>
		if desc := meta.Description(); desc != "" {
			<p class="description">{ desc }</p>
		}
		if len(meta.Tags()) > 0 {
			@TagList() {
				for _, t := range meta.Tags() {
					@Tag(t)
				}
			}
		}
		<section class="recipe-source">
			@ButtonGroup() {
				<a href={ templ.URL(baseURL + "/") }>View all recipes</a>
				if source := meta.Source(); source != nil {
					@IconButton("external-link", source.String())
				}
			}
		</section>
		@TagList() {
			if t := meta.TotalTime(); t != "" {
				<span><strong>Total time:</strong> { t }</span>
			}
			if t := meta.PrepTime(); t != "" {
				<span><strong>Prep time:</strong> { t }</span>
			}
			if t := meta.CookTime(); t != "" {
				<span><strong>Cook time:</strong> { t }</span>
			}
		}
		@TagList() {
			if value := meta.Cuisine(); value != "" {
				@Tag(value)
			}
			if value := meta.Course(); value != "" {
				@Tag(value)
			}
			if value := meta.Category(); value != "" {
				@Tag(value)
			}
		}
	</header>
}

templ recipeInstructions(recipe *cooklang.RecipeV2, file RecipeFile) {
	<section id="instructions">
		<h2>Instructions</h2>
		for _, step := range recipe.Steps {
			for _, component := range step {
				@cooklangStep(component, file)
			}
		}
	</section>
}

templ recipeIngredients(recipe *cooklang.RecipeV2, servings float64, file RecipeFile) {
	<aside id="ingredients">
		<h2>
			Ingredients
			if servings > 0 {
				@servingsLabel(servings)
			}
		</h2>
		@cooklangIngredientList(recipe.Steps, file)
	</aside>
}

templ servingsLabel(servings float64) {
	<div id="servings">
		<i data-lucide="utensils" style="max-width: 1em; max-height: 1em;"></i>{ servings }
	</div>
}

templ cooklangIngredientList(steps []cooklang.StepV2, file RecipeFile) {
	<ul>
		for _, section := range steps {
			for _, step := range section {
				switch val := step.(type) {
					case cooklang.IngredientV2:
						@cooklangIngredientListItem(val, file)
				}
			}
		}
	</ul>
}

templ cooklangIngredientListItem(val cooklang.IngredientV2, file RecipeFile) {
	<li class="ingredient-list-item">
		@cooklangIngredientText(val.Name, file)
		switch  {
			case val.Units == "" && val.Quantity == 0:
				<span></span>
			case val.Units == "":
				<span>{ fmt.Sprintf("%v ", val.Quantity) }</span>
			default:
				<span>{ fmt.Sprintf("%v %s ", val.Quantity, val.Units) }</span>
		}
	</li>
}

templ recipeCookware(recipe *cooklang.RecipeV2, file RecipeFile) {
	<aside id="cookware">
		<h2>Cookware </h2>
		@cooklangCookwareList(recipe.Steps, file)
	</aside>
}

templ cooklangCookwareList(steps []cooklang.StepV2, file RecipeFile) {
	<ul>
		for _, section := range steps {
			for _, step := range section {
				switch val := step.(type) {
					case cooklang.CookwareV2:
						@cooklangCookwareListItem(val, file)
				}
			}
		}
	</ul>
}

templ cooklangCookwareListItem(val cooklang.CookwareV2, file RecipeFile) {
	<li class="cookware-list-item">
		{ val.Name }
		if val.Quantity > 1 {
			<span>{ fmt.Sprintf("%v ", val.Quantity) }</span>
		}
	</li>
}
