package views

import (
	"fmt"
	"strings"

	"github.com/aquilax/cooklang-go"
	"github.com/marcusolsson/cookhub/utils"
	"github.com/marcusolsson/cookhub/db/sqlc"
)

type RecipeViewModel struct {
	Recipe    *cooklang.RecipeV2
	RawRecipe string
	File      db.GetFileRow
}

func fileID(file db.GetFileRow) string {
	return strings.Join([]string{file.Provider, file.Owner, file.RepoName, file.Path}, "/")
}

func canonicalFileURL(file db.GetFileRow) string {
	return "https://" + fileID(file)
}

func relativeFileURL(file db.GetFileRow) string {
	return "/" + fileID(file)
}

templ RecipePage(pd *RecipeViewModel) {
	{{ meta := utils.ParseCanonicalMetadata(pd.Recipe) }}
	<!DOCTYPE html>
	<html>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>CookHub</title>
			<link rel="stylesheet" href="/static/styles.css"/>
			<link rel="canonical" href={ templ.URL(canonicalFileURL(pd.File)) }/>
		</head>
		<body>
			@navigation()
			<main class="container">
				@recipePageHeader(meta, pd.File)
				@Columns() {
					@recipeIngredients(pd.Recipe, meta.Servings(), pd.File)
					@recipeInstructions(pd.Recipe, pd.File)
				}
				<details>
					<summary>View the raw recipe</summary>
					<pre>
						<code>{ pd.RawRecipe }</code>
					</pre>
				</details>
			</main>
			@lucideIcons()
		</body>
	</html>
}

templ recipePageHeader(meta *utils.RecipeMetadata, file db.GetFileRow) {
	<header class="recipe-header">
		<h1>{ meta.Title(file.Path) }</h1>
		if desc := meta.Description(); desc != "" {
			<p class="description">{ desc }</p>
		}
		if len(meta.Tags()) > 0 {
			@TagList() {
				for _, t := range meta.Tags() {
					@Tag(t)
				}
			}
		}
		<section class="recipe-source">
			@Author(file.Owner, fmt.Sprintf("https://%s/%s", file.Provider, file.Owner))
			@ButtonGroup() {
				@IconButton("github", string(canonicalFileURL(file)))
				if source := meta.Source(); source != nil {
					@IconButton("external-link", source.String())
				}
			}
		</section>
		@TagList() {
			if t := meta.TotalTime(); t != "" {
				<span><strong>Total time:</strong> { t }</span>
			}
			if t := meta.PrepTime(); t != "" {
				<span><strong>Prep time:</strong> { t }</span>
			}
			if t := meta.CookTime(); t != "" {
				<span><strong>Cook time:</strong> { t }</span>
			}
		}
		@TagList() {
			if value := meta.Cuisine(); value != "" {
				@Tag(value)
			}
			if value := meta.Course(); value != "" {
				@Tag(value)
			}
			if value := meta.Category(); value != "" {
				@Tag(value)
			}
		}
		if u := meta.ImageURL(); u != "" {
			@Image(u)
		}
	</header>
}

templ recipeInstructions(recipe *cooklang.RecipeV2, file db.GetFileRow) {
	<section id="instructions">
		<h2>Instructions</h2>
		for _, step := range recipe.Steps {
			for _, component := range step {
				@cooklangStep(component, file)
			}
		}
	</section>
}

templ recipeIngredients(recipe *cooklang.RecipeV2, servings float64, file db.GetFileRow) {
	<aside id="ingredients">
		<h2>
			Ingredients
			if servings > 0 {
				@servingsLabel(servings)
			}
		</h2>
		@cooklangIngredientList(recipe.Steps, file)
	</aside>
}

templ servingsLabel(servings float64) {
	<div id="servings">
		<i data-lucide="utensils" style="max-width: 1em; max-height: 1em;"></i>{ servings }
	</div>
}

templ cooklangIngredientList(steps []cooklang.StepV2, file db.GetFileRow) {
	<ul>
		for _, section := range steps {
			for _, step := range section {
				switch val := step.(type) {
					case cooklang.IngredientV2:
						@cooklangIngredientListItem(val, file)
				}
			}
		}
	</ul>
}

templ cooklangIngredientListItem(val cooklang.IngredientV2, file db.GetFileRow) {
	<li class="ingredient-list-item">
		@cooklangIngredientText(val.Name, file)
		switch  {
			case val.Units == "" && val.Quantity == 0:
				<span></span>
			case val.Units == "":
				<span>{ fmt.Sprintf("%v ", val.Quantity) }</span>
			default:
				<span>{ fmt.Sprintf("%v %s ", val.Quantity, val.Units) }</span>
		}
	</li>
}
